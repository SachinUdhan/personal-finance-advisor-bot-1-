# Flask Configuration
SECRET_KEY=dev-secret-key-change-this-in-production-12345
FLASK_ENV=development
FLASK_DEBUG=True

# Database Configuration (Defaults to local SQLite if empty)
DATABASE_URL=sqlite:///finance_bot.db

# Optional AI API Key (e.g., Google Gemini or OpenAI)
# If left blank, the application uses its built-in rule-based intelligent financial advisor
AI_API_KEY=
AI_PROVIDER=gemini
